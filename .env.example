# --- Gemini (Path A) -------------------------------------------------------
# MUST be a PAID-TIER key. Free-tier content is used to improve Google's
# products, which conflicts with the confidentiality constraint in the brief.
# See COMPLIANCE.md. Nothing that sends audio may run without this.
GEMINI_API_KEY=

# Model IDs live in config, not code, so pricing/retirement changes are a
# config edit rather than a code change.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# 0 disables thinking. A/B'd at T0 - see plan section 12.
GEMINI_THINKING_BUDGET=0

# --- Privacy ---------------------------------------------------------------
# When true, Path A is disabled entirely and only the deterministic Path B
# runs. Zero data egress. This is the enterprise deployment mode.
LOCAL_ONLY=false

# Uploaded audio is deleted on job completion or after this many hours,
# whichever comes first.
UPLOAD_RETENTION_HOURS=24

# --- Dashboard auth --------------------------------------------------------
APP_USER=autoace
APP_PASSWORD=
SESSION_SECRET=

# --- Runtime ---------------------------------------------------------------
MAX_CONCURRENCY=4
DATABASE_URL=sqlite:///./autoace.db
